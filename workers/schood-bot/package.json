{
  "name": "schood-bot",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "setup-webhook": "node -e \"const t=process.env.TELEGRAM_BOT_TOKEN,u=process.env.WORKER_URL,s=process.env.WEBHOOK_SECRET;fetch('https://api.telegram.org/bot'+t+'/setWebhook',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({url:u+'/webhook',secret_token:s,allowed_updates:['message','callback_query']})}).then(r=>r.json()).then(console.log)\""
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240925.0",
    "wrangler": "^3.80.0"
  }
}
