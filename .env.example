# Supabase local dev and tools
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase Auth providers (server-side provider configuration only)
# Configure the matching callback URLs in Google Cloud and BotFather.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
SUPABASE_AUTH_CUSTOM_TELEGRAM_CLIENT_ID=
SUPABASE_AUTH_CUSTOM_TELEGRAM_SECRET=

# Click
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_MERCHANT_USER_ID=
CLICK_SECRET_KEY=
# Fiscalization (OFD) — leave disabled until tax data + a real test payment exist
CLICK_FISCALIZATION_ENABLED=
CLICK_FISCAL_TIN=
CLICK_FISCAL_PINFL=
PAYMENT_SUCCESS_STATUSES=paid,success,completed

# App handoff URLs
ACADEMY_APP_URL=https://academy.schood.online
# Activate only after the additive migration and Academy Edge functions are deployed.
VITE_ACADEMY_TEACHER_FLOW_V2=false

# Academy production smoke checks. Prefer email/password smoke credentials so CI can mint fresh JWTs.
# Token variables are still supported for one-off local checks; never commit values.
ACADEMY_EDGE_URL=
ACADEMY_SMOKE_TOKEN=
ACADEMY_STUDENT_SMOKE_TOKEN=
ACADEMY_SMOKE_EMAIL=
ACADEMY_SMOKE_PASSWORD=
ACADEMY_STUDENT_SMOKE_EMAIL=
ACADEMY_STUDENT_SMOKE_PASSWORD=
ACADEMY_SMOKE_ACADEMY_ID=

# Telegram bot identities and internal Worker-to-Edge authentication
TELEGRAM_PUBLIC_BOT_TOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_NAME=schoodstudentbot
TELEGRAM_INTERNAL_SECRET=
TELEGRAM_RATE_LIMIT_SECRET=
PUBLIC_JOURNEY_HASH_SECRET=
DOMAIN_EVENTS_WORKER_SECRET=
ACADEMY_WORKER_SECRET=
ACADEMY_TELEGRAM_BOT_TOKEN=
ACADEMY_TELEGRAM_BOT_NAME=schoodacademybot
ACADEMY_SITE_URL=https://academy.schood.online
ACADEMY_TELEGRAM_WORKER_URL=https://academy-bot.schood.online
ACADEMY_TELEGRAM_INTERNAL_SECRET=
ACADEMY_TELEGRAM_WEBHOOK_SECRET=
# Keep the previous webhook secret only during a deliberate rotation overlap.
WEBHOOK_SECRET=
WEBHOOK_SECRET_PREVIOUS=

# Partner center messaging
PARTNER_SMS_PROVIDER=generic
PARTNER_SMS_GATEWAY_URL=
PARTNER_SMS_GATEWAY_TOKEN=
ESKIZ_SMS_BASE_URL=https://notify.eskiz.uz/api
ESKIZ_SMS_EMAIL=
ESKIZ_SMS_PASSWORD=
ESKIZ_SMS_FROM=4546
ESKIZ_SMS_CALLBACK_URL=

# AI (Edge Function secrets)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-31b-it:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_APP_NAME=Schood IELTS
OPENROUTER_REFERER=https://schood.online
# Homework OS AI pre-marking (academy-learning). Defaults to the free OPENROUTER_MODEL; paid models need HOMEWORK_AI_ALLOW_PAID=true.
HOMEWORK_AI_MODEL=
HOMEWORK_AI_ALLOW_PAID=false
# Optional override; the pg_cron call normally uses internal_runtime_secrets.academy_learning_secret.
ACADEMY_LEARNING_WORKER_SECRET=
# Dedicated AI add-on product UUID only; unrelated purchases do not increase quotas.
AI_ADDON_PRODUCT_ID=
# Positive daily service caps are required to enable the version 2 AI handlers.
WRITING_TUTOR_SERVICE_DAILY_LIMIT=
SPEAKING_COACH_SERVICE_DAILY_LIMIT=
SAT_TUTOR_SERVICE_DAILY_LIMIT=
ENGLISH_AI_PROVIDER=openai
ENGLISH_AI_FALLBACK=openrouter
ENGLISH_AI_DAILY_LIMIT=30
# "Check my English" in @schoodonlinebot (telegram-public): checks per day across all chats (default 300).
ENGLISH_TG_CHECK_DAILY_LIMIT=300

# Frontend build metadata (set to the deployed commit SHA by CI)
VITE_RELEASE_SHA=

# SMTP (Supabase Auth email via Gmail)
GMAIL_SMTP_EMAIL=
GMAIL_SMTP_APP_PASSWORD=
GMAIL_ADMIN_EMAIL=
# Cloudflare Stream (Academy managed video; values live in Supabase Edge secrets)
CLOUDFLARE_STREAM_ACCOUNT_ID=
CLOUDFLARE_STREAM_API_TOKEN=
CLOUDFLARE_STREAM_CUSTOMER_CODE=
CLOUDFLARE_STREAM_SIGNING_KEY_ID=
CLOUDFLARE_STREAM_SIGNING_PRIVATE_JWK=

# Academy SMS webhook: HTTPS JSON {phone,message,reference}; 2xx means provider acceptance.
ACADEMY_SMS_GATEWAY_URL=
ACADEMY_SMS_GATEWAY_TOKEN=

# Private assignment audio; generate once, retain securely, never rotate without re-encrypting existing recordings.
ACADEMY_AUDIO_ENCRYPTION_KEY=

# Independent Assessment/Proctor live service. Keep disabled until release gates pass.
PROCTOR_LIVE_ENABLED=false
PROCTOR_LIVE_LAUNCH=false
ASSESSMENT_LIVE_LAUNCH=false
PROCTOR_LIVE_BROKER_SECRET=
PROCTOR_SFU_APP_ID=
PROCTOR_SFU_APP_SECRET=
PROCTOR_TURN_KEY_ID=
PROCTOR_TURN_KEY_SECRET=
VITE_PROCTOR_LIVE_URL=

# Separate private certificate document renderer; no browser secrets.
ASSESSMENT_CERTIFICATE_DOCUMENTS=false
ASSESSMENT_DOCUMENT_URL=
ASSESSMENT_DOCUMENT_SECRET=
ASSESSMENT_CERTIFICATE_VERIFICATION_URL=

# Institution webhooks (Edge + separate delivery Worker). Keys: JSON {"id":"base64 32 bytes"}.
ASSESSMENT_WEBHOOKS_ENABLED=false
ASSESSMENT_WEBHOOK_KEYS=
ASSESSMENT_WEBHOOK_ACTIVE_KEY=
ASSESSMENT_WEBHOOK_DISPATCH_SECRET=

# Institution integration API (client credentials, scoped v1). Off by default.
ASSESSMENT_API_CLIENTS_ENABLED=false

# Schood Admission (edge function `admission`). Off until both are set.
ADMISSION_ENABLED=false
# Tenant id of the Schood content workspace in Assessment Cloud that holds approved questions.
ADMISSION_CONTENT_TENANT_ID=
ADMISSION_ALLOWED_ORIGINS=https://admission.schood.online
# Full subscription product (Click → entitlements). Unset: open beta, everyone has full access.
ADMISSION_PRODUCT_ID=
# Practice and review questions a free learner gets each day (default 10).
ADMISSION_FREE_DAILY_QUESTIONS=10

# Schood AI (edge function `schood-ai`, app ai.schood.online). No free AI use:
# with no product ids set, only Schood admins and the beta allowlist have access.
SCHOOD_AI_ALLOWED_ORIGINS=https://ai.schood.online
# Schood product ids per plan (Click -> entitlements). Unset: nobody holds that plan.
SCHOOD_AI_PLUS_PRODUCT_ID=
SCHOOD_AI_FAMILY_PRODUCT_ID=
SCHOOD_AI_TEACHER_PRODUCT_ID=
SCHOOD_AI_TEACHER_PRO_PRODUCT_ID=
SCHOOD_AI_CENTRE_PRODUCT_ID=
SCHOOD_AI_CENTRE_PRO_PRODUCT_ID=
# Comma-separated Schood user ids with beta access (they get a beta credit grant).
SCHOOD_AI_BETA_USER_IDS=
# Shared secret of the Telegram worker (at least 32 characters). Unset: worker path off.
SCHOOD_AI_SERVICE_SECRET=
# Optional hard ceiling on model calls per Tashkent day; the admin settings can only lower it.
SCHOOD_AI_GLOBAL_DAILY_CALLS=
# Learner area: the app URL used in Telegram links (default https://ai.schood.online). The student
# bot Worker (workers/schood-bot) needs SCHOOD_AI_SERVICE_SECRET as a Worker secret with the same value.
SCHOOD_AI_APP_URL=
# Learner area, AI duels (L17): optional overrides of the English app URL and the student bot name.
ENGLISH_APP_URL=
TELEGRAM_STUDENT_BOT_NAME=
# Provider keys are named by the model registry (ai_providers.api_key_env), for example
# OPENROUTER_API_KEY (already set), OPENAI_API_KEY, ANTHROPIC_API_KEY, GEMINI_API_KEY,
# GROQ_API_KEY, CLOUDFLARE_AI_API_TOKEN (a Workers AI token, never the Pages deploy token)
# or SCHOOD_AI_KEY_<NAME> for a custom endpoint.
CLOUDFLARE_AI_API_TOKEN=
