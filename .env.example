# TSPay
TSPAY_SHOP_ACCESS_TOKEN=
TSPAY_EMAIL=
TSPAY_PASSWORD=
TSPAY_BASE_URL=https://tspay.uz/api/v1
# IMPORTANT: TsPay often returns top-level { status: "success" } meaning "API call ok";
# the payment status is typically data.pay_status (e.g. "paid"). Default to "paid".
TSPAY_SUCCESS_STATUSES=paid

