# QTI remains disabled until complete source/AV/parser/center workflow acceptance.
ASSESSMENT_QTI_ENABLED=false
ASSESSMENT_QTI_TRANSPORT_SECRET=
ASSESSMENT_QTI_SCANNER_SECRET=
ASSESSMENT_QTI_PARSER_SECRET=
ASSESSMENT_QTI_SCANNER_ID=
# Exact approved processing build identity, 64 lowercase hexadecimal characters.
ASSESSMENT_QTI_PROCESSOR_ID=

# Staff invitations are isolated from Academy/Proctor. Keep disabled until the
# matching migration/API/app and all release gates are verified together.
ASSESSMENT_INVITATIONS_ENABLED=false
ASSESSMENT_APP_URL=
# Separate from certificate, media, QTI and Auth keys. Values are base64url
# encodings of exactly 32 random bytes, e.g. {"2026-10":"<secret>"}.
ASSESSMENT_INVITATION_ACTIVE_KEY=
ASSESSMENT_INVITATION_KEYS=
ASSESSMENT_INVITATION_MAIL_ENABLED=false
# Dedicated mail-control key; do not reuse signing, QTI, roster or media keys.
ASSESSMENT_MAIL_WORKER_SECRET=
