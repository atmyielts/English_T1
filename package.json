{
  "name": "english-platform",
  "private": true,
  "workspaces": [
    "apps/platform",
    "apps/ielts-simulator",
    "apps/ielts-practice",
    "apps/ielts-playbook",
    "apps/sat-simulator",
    "apps/sat-practice",
    "apps/sat-playbook",
    "apps/toefl-ibt-simulator",
    "apps/toefl-playbook",
    "apps/itep-simulator",
    "apps/academy",
    "apps/english-hub",
    "workers/*",
    "packages/*"
  ],
  "scripts": {
    "test": "npm run test:sat && npm run test:shared",
    "test:shared": "deno test supabase/functions/_shared/payment-terms.test.ts supabase/functions/_shared/pricing.test.ts supabase/functions/_shared/entitlements.test.ts supabase/functions/_shared/academy-scoring.test.ts supabase/functions/_shared/english-learning.test.ts",
    "test:english-core": "deno test supabase/functions/_shared/english-learning.test.ts",
    "test:sat": "npm --workspace sat-simulator run test",
    "test:academy:routes": "npm --workspace apps/academy run test:routes",
    "test:academy:edge": "deno test --allow-env supabase/functions/academy/academy-contract.test.ts",
    "verify:english": "node scripts/run-english-verifications.mjs",
    "verify:academy": "node scripts/verify-academy-product-readiness.mjs",
    "smoke:academy": "node scripts/smoke-academy-product.mjs",
    "smoke:academy:live": "node scripts/smoke-academy-product.mjs --live",
    "check:academy:github": "node scripts/check-academy-github-readiness.mjs",
    "verify:prod": "node scripts/verify-production-readiness.mjs"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.18",
    "autoprefixer": "^10.4.23",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.89.0"
  }
}
