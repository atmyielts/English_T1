{
  "name": "english-platform",
  "private": true,
  "workspaces": [
    "apps/platform",
    "apps/ielts-simulator",
    "apps/ielts-practice",
    "apps/ielts-playbook",
    "apps/sat-simulator",
    "apps/sat-practice",
    "apps/sat-playbook",
    "apps/toefl-ibt-simulator",
    "apps/toefl-playbook",
    "apps/itep-simulator",
    "apps/academy",
    "apps/academy-docs",
    "apps/english-hub",
    "workers/*",
    "packages/*"
  ],
  "scripts": {
    "test": "npm run test:sat && npm run test:shared && npm run test:telegram",
    "test:shared": "deno test --allow-read supabase/functions/_shared/payment-terms.test.ts supabase/functions/_shared/pricing.test.ts supabase/functions/_shared/entitlements.test.ts supabase/functions/_shared/academy-scoring.test.ts supabase/functions/_shared/academy-curriculum.test.ts supabase/functions/_shared/english-learning.test.ts supabase/functions/_shared/internal-service-auth.test.ts supabase/functions/academy/access-matrix.test.ts supabase/functions/click/webhook-security.test.ts supabase/functions/click/payment-safety.test.ts supabase/functions/click/payment-flow-simulation.test.ts supabase/functions/click/launch-contract.test.ts",
    "test:english-core": "deno test supabase/functions/_shared/english-learning.test.ts",
    "test:sat": "npm --workspace sat-simulator run test",
    "test:academy:routes": "npm --workspace apps/academy run test:routes",
    "test:academy:edge": "deno test --allow-env --allow-read supabase/functions/academy/academy-contract.test.ts supabase/functions/academy/curriculum-schema-contract.test.ts supabase/functions/academy/business-os-phase-a-schema-contract.test.ts supabase/functions/academy/business-os-phase-b-schema-contract.test.ts supabase/functions/academy/business-os-phase-c-schema-contract.test.ts supabase/functions/academy/business-os-phase-d-schema-contract.test.ts supabase/functions/academy/business-os-phase-e-schema-contract.test.ts supabase/functions/academy/business-os-phase-f-schema-contract.test.ts supabase/functions/academy/business-os-phase-g-schema-contract.test.ts supabase/functions/academy/business-os-phase-h-schema-contract.test.ts supabase/functions/academy/business-os-phase-i-schema-contract.test.ts supabase/functions/academy/business-os-phase-j-schema-contract.test.ts supabase/functions/academy/business-os-phase-k-schema-contract.test.ts supabase/functions/academy/access-matrix.test.ts supabase/functions/telegram-app/guardian-contract.test.ts supabase/functions/_shared/academy-curriculum.test.ts",
    "test:telegram": "deno test --allow-read supabase/functions/_shared/internal-auth.test.ts supabase/functions/_shared/telegram-init-data.test.ts supabase/functions/_shared/telegram-growth.test.ts supabase/functions/_shared/telegram-delivery.test.ts supabase/functions/_shared/telegram-release-contract.test.ts",
    "verify:english": "node scripts/run-english-verifications.mjs",
    "verify:academy": "node scripts/verify-academy-product-readiness.mjs",
    "smoke:academy": "node scripts/smoke-academy-product.mjs",
    "smoke:academy:live": "node scripts/smoke-academy-product.mjs --live",
    "verify:academy:lifecycle": "powershell -NoProfile -Command \"Get-Content -Raw -LiteralPath 'scripts/verify-academy-33-step-lifecycle.sql' | docker exec -i supabase_db_English_T1 psql -v ON_ERROR_STOP=1 -U postgres -d postgres\"",
    "verify:academy:invariants": "powershell -NoProfile -Command \"Get-Content -Raw -LiteralPath 'scripts/verify-academy-business-os-invariants.sql' | docker exec -i supabase_db_English_T1 psql -v ON_ERROR_STOP=1 -U postgres -d postgres\"",
    "verify:academy:automation": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-academy-automation-worker.ps1",
    "check:academy:github": "node scripts/check-academy-github-readiness.mjs",
    "verify:prod": "node scripts/verify-production-readiness.mjs",
    "verify:click-prod": "node scripts/verify-click-production-readiness.mjs",
    "verify:telegram:identities": "node scripts/verify-telegram-bot-identities.mjs",
    "verify:telegram:local": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-telegram-growth-local.ps1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.18",
    "autoprefixer": "^10.4.23",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1085.0",
    "@aws-sdk/s3-request-presigner": "3.1085.0",
    "@supabase/supabase-js": "^2.89.0"
  }
}
