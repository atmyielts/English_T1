{
  "name": "english-platform",
  "private": true,
  "workspaces": [
    "apps/platform",
    "apps/ielts-simulator",
    "apps/ielts-practice",
    "apps/ielts-playbook",
    "apps/sat-simulator",
    "apps/sat-practice",
    "apps/sat-playbook",
    "apps/toefl-ibt-simulator",
    "apps/itep-simulator",
    "apps/academy",
    "apps/english-reading",
    "apps/english-writing",
    "apps/english-listening",
    "apps/english-speaking",
    "apps/english-grammar",
    "apps/english-vocabulary",
    "apps/english-immersion",
    "apps/english-hub",
    "packages/*"
  ],
  "scripts": {
    "test": "npm run test:sat && npm run test:english-core",
    "test:english-core": "deno test supabase/functions/_shared/english-learning.test.ts",
    "test:sat": "npm --workspace sat-simulator run test",
    "verify:english": "node scripts/run-english-verifications.mjs",
    "verify:prod": "node scripts/verify-production-readiness.mjs"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.18",
    "autoprefixer": "^10.4.23",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.89.0"
  }
}
