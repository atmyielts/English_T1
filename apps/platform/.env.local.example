VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Comma-separated list of allowed return hosts for cross-domain redirects.
# Example: ielts.schood.online,sat.schood.online,reading.english.schood.online,.schood.online
VITE_ALLOWED_RETURN_HOSTS=

# Optional: admin panel URL (if admin lives on a product app).
VITE_ADMIN_URL=

# Optional: IELTS product app base URL (for candidate handoff).
# Example: https://ielts.schood.online
VITE_IELTS_URL=

# Optional: Academy app base URL for deep links from platform student workspace.
# Example: https://academy.schood.online
VITE_ACADEMY_URL=

# Optional: cookie domain for shared auth across subdomains (e.g. .schood.xyz).
VITE_AUTH_COOKIE_DOMAIN=
VITE_AUTH_SHARED_COOKIE=true
