VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Base URL for the platform shell (auth/billing/account).
# Example: https://schood.online
VITE_PLATFORM_URL=

# Optional: cookie domain for shared auth across subdomains (e.g. .schood.xyz).
VITE_AUTH_COOKIE_DOMAIN=

# Optional: custom auth storage key (default: schood-auth for platform SSO compatibility).
# IMPORTANT: if this differs from platform app storage key, /auth redirect may loop.
VITE_AUTH_STORAGE_KEY=

# Optional: verbose auth/session request logs in browser console (true/false).
VITE_DEBUG_AUTH=false

# Optional: skip redirecting to /pricing while you're developing UI flows.
# Note: DB RLS still protects paid content, so you typically want trial/grants anyway.
VITE_DISABLE_PAYWALL=false
