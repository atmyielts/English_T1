/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'; base-uri 'self'; object-src 'none'; upgrade-insecure-requests
  Strict-Transport-Security: max-age=86400
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(self), microphone=(self)
/embed/*
  Access-Control-Allow-Origin: *
  Cross-Origin-Resource-Policy: cross-origin
  Cache-Control: public, max-age=300
# The widget bridge is framed by centres' own websites: it shows nothing and answers
# only the window that framed it (Pages serves it at /embed/bridge).
/embed/bridge
  ! X-Frame-Options
  ! Content-Security-Policy
/embed/bridge.html
  ! X-Frame-Options
  ! Content-Security-Policy
